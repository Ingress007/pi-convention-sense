{
  "name": "pi-convention-sense",
  "version": "0.4.0-alpha.1",
  "description": "Evidence-driven local convention awareness for Pi coding agents",
  "license": "MIT",
  "author": "Ingress007",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ingress007/pi-convention-sense.git"
  },
  "bugs": {
    "url": "https://github.com/Ingress007/pi-convention-sense/issues"
  },
  "homepage": "https://github.com/Ingress007/pi-convention-sense#readme",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "conventions"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions",
    "src",
    "docs",
    "examples",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "verify": "npm run check && npm test",
    "coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=\"dist/src/**\" --test-coverage-include=\"dist/extensions/**\" --test-coverage-lines=88 --test-coverage-branches=78 --test-coverage-functions=88 \"dist/test/*.test.js\"",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "minimatch": "10.2.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
